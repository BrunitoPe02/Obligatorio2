ip route add 192.168.100.0/24 via 192.168.77.2   # LANA
ip route add 203.0.113.32/28 via 172.16.77.30    # DMZ B
ip route add 192.168.77.4/30 via 172.16.77.30    # rclb
ip route add 192.168.77.0/30 via 192.168.77.2    # rcla
ip route add 203.0.113.0/27 via 192.168.77.2     # 

ip route add 172.16.77.0/30 via 172.16.77.13    #r1-rint
ip route add 172.16.77.8/30 via 172.16.77.13    #r1-r2 DESEMPATE
ip route add 172.16.77.20/30 via 172.16.77.17   #r2-r4
ip route add 172.16.77.24/30 via 172.16.77.17   #r2-r5 DESEMPATE
ip route add 172.16.77.32/30 via 172.16.77.30   #r4-r5
ip route add 172.16.77.36/30 via 172.16.77.17   #r4-r6 DESEMPATE
ip route add 172.16.77.40/30 via 172.16.77.30   #r5-r6 
