systemctl start frr

# direcciones ip
ip addr add 172.16.77.22/30 dev eth0 #r2
ip addr add 172.16.77.33/30 dev eth1 #r5
ip addr add 172.16.77.37/30 dev eth2 #r6

# rutas estáticas
ip route add 8.8.8.0/24 via 172.16.77.38   # rint
ip route add 192.168.100.0/24 via 172.16.77.21   # LANA ===== desempateeeee
ip route add 203.0.113.0/27 via 172.16.77.21     # Cliente A (IP de NAT) DESEMPATE
ip route add 203.0.113.32/28 via 172.16.77.34    # DMZ B
ip route add 192.168.77.4/30 via 172.16.77.34    # rclb
ip route add 192.168.77.0/30 via 172.16.77.21    # rcla === desempateee

ip route add 172.16.77.0/30 via 172.16.77.21    #r1-rint DESEMPATE
ip route add 172.16.77.8/30 via 172.16.77.21    #r1-r2 
ip route add 172.16.77.12/30 via 172.16.77.21   #r1-r3 DESEMPATE
ip route add 172.16.77.16/30 via 172.16.77.21   #r2-r3
ip route add 172.16.77.24/30 via 172.16.77.21   #r2-r5 DESEMPATE
ip route add 172.16.77.28/30 via 172.16.77.34   #r3-r5
ip route add 172.16.77.40/30 via 172.16.77.34   #r5-r6 DESEMPATE
ip route add 172.16.77.4/30 via 172.16.77.38   #r6-rint
