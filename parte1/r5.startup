systemctl start frr

# direcciones ip
ip addr add 172.16.77.26/30 dev eth0 #r2
ip addr add 172.16.77.30/30 dev eth1 #r3
ip addr add 172.16.77.34/30 dev eth2 #r4
ip addr add 172.16.77.41/30 dev eth3 #r6
ip addr add 192.168.77.5/30 dev eth4 #rclB

# rutas estáticas
ip route add 8.8.8.0/24 via 172.16.77.42   # rint
ip route add 192.168.100.0/24 via 172.16.77.29   # LANA
ip route add 203.0.113.32/28 via 172.16.77.4    # DMZ B
ip route add 192.168.77.4/30 via 192.168.77.6    # rclb
ip route add 192.168.77.0/30 via 172.16.77.29    # rcla

ip route add 172.16.77.0/30 via 172.16.77.25    #r1-rint DESEMPATE
ip route add 172.16.77.8/30 via 172.16.77.25    #r1-r2
ip route add 172.16.77.12/30 via 172.16.77.29   #r1-r3
ip route add 172.16.77.16/30 via 172.16.77.25   #r2-r3 DESEMPATE
ip route add 172.16.77.20/30 via 172.16.77.25   #r2-r4 DESEMPATE
ip route add 172.16.77.36/30 via 172.16.77.33   #r4-r6 DESEMPATE
ip route add 172.16.77.4/30 via 172.16.77.42    #r6-rint
