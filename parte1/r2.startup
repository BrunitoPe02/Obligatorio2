systemctl start frr

ip addr add 172.16.77.10/30 dev eth0   # hacia r1
ip addr add 172.16.77.17/30 dev eth1   # hacia r3
ip addr add 172.16.77.21/30 dev eth2   # hacia r4
ip addr add 172.16.77.25/30 dev eth3   # hacia r5

# rutas estáticas: camino más corto sin pasar por rint; si empata, el router de menor número.
ip route add 8.8.8.0/24 via 172.16.77.9          # rint
ip route add 192.168.100.0/24 via 172.16.77.18   # LANA
ip route add 203.0.113.0/27 via 172.16.77.18     # Cliente A
ip route add 203.0.113.32/28 via 172.16.77.26    # DMZ B
ip route add 192.168.77.4/30 via 172.16.77.26    # rclb
ip route add 192.168.77.0/30 via 172.16.77.18    # rcla

ip route add 172.16.77.0/30 via 172.16.77.9     #r1-rint
ip route add 172.16.77.12/30 via 172.16.77.9    #r1-r3 DESEMPATE
ip route add 172.16.77.28/30 via 172.16.77.18   #r3-r5 DESEMPATE
ip route add 172.16.77.32/30 via 172.16.77.22   #r4-r5 DESEMPATE
ip route add 172.16.77.36/30 via 172.16.77.22   #r4-r6
ip route add 172.16.77.40/30 via 172.16.77.26   #r5-r6
ip route add 172.16.77.4/30 via 172.16.77.22    #r6-rint DESEMPATE
